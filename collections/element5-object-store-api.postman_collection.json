        {
          "id": "a388c7bd-4f83-4665-8978-6745e48fbc42",
          "name": "Upload a file object",
          "request": {
            "name": "Upload a file object",
            "description": {
              "content": "Upload a file to S3 storage. The file is stored in a date-based folder structure (YYYY/MM/DD). Returns file object ID and download URL. Requires `file:write` scope in the authorization token.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "store",
                "v1",
                "file-object"
              ],
              "host": [
                "blob-qa",
                "e5",
                "ai"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "(Required) File to upload"
                }
              ]
            }
          },
